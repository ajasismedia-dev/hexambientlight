<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modern Colors -->
    <Color x:Key="ModernBgColor">#0F0F13</Color>
    <Color x:Key="ModernSurfaceColor">#1A1A20</Color>
    <Color x:Key="ModernAccentColor">#00E5FF</Color>
    <Color x:Key="ModernAccentDimColor">#007788</Color>
    
    <SolidColorBrush x:Key="ModernBgBrush" Color="{StaticResource ModernBgColor}" />
    <SolidColorBrush x:Key="ModernSurfaceBrush" Color="{StaticResource ModernSurfaceColor}" />
    <SolidColorBrush x:Key="ModernAccentBrush" Color="{StaticResource ModernAccentColor}" />
    <SolidColorBrush x:Key="ModernAccentDimBrush" Color="{StaticResource ModernAccentDimColor}" />
    <SolidColorBrush x:Key="ModernTextBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ModernTextMutedBrush" Color="#808080" />

    <!-- Modern Slider -->
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
        <Setter Property="Background" Value="{StaticResource ModernSurfaceBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border x:Name="TrackBackground" Height="4" Background="{StaticResource ModernBgBrush}" CornerRadius="2" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="{StaticResource ModernAccentBrush}" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource ModernAccentBrush}" Stroke="{StaticResource ModernBgBrush}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Segmented Button (RadioButton styled as button) -->
    <Style x:Key="ModernSegmentedButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource ModernBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ModernTextMutedBrush}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ModernSurfaceBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource ModernSurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ModernAccentBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ModernAccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ModernTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Color Swatch Button -->
    <Style x:Key="ColorSwatchStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="#444" BorderThickness="1">
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

