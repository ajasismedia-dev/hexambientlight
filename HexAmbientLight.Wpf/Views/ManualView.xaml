<UserControl x:Class="HexAmbientLight.Wpf.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>
    <StackPanel Margin="10">
        <TextBlock Text="Manual Control" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,5"/>
        <TextBlock Text="Set solid colors directly" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,20"/>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Quick Presets" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>
                <UniformGrid Columns="3" Rows="2">
                    <Button Content="Cyan" Command="{Binding SetPresetCommand}" CommandParameter="#29D3FF" Margin="5"/>
                    <Button Content="Blue" Command="{Binding SetPresetCommand}" CommandParameter="#4D7CFF" Margin="5"/>
                    <Button Content="Purple" Command="{Binding SetPresetCommand}" CommandParameter="#9D6BFF" Margin="5"/>
                    <Button Content="Red" Command="{Binding SetPresetCommand}" CommandParameter="#FF4D5E" Margin="5"/>
                    <Button Content="Lime" Command="{Binding SetPresetCommand}" CommandParameter="#B7FF57" Margin="5"/>
                    <Button Content="Warm White" Command="{Binding SetPresetCommand}" CommandParameter="#FFE4B5" Margin="5"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Color Picker" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>
                
                <StackPanel Orientation="Horizontal">
                    <Border Width="100" Height="100" CornerRadius="5" HorizontalAlignment="Left" Margin="0,0,20,0">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding SelectedColor}"/>
                        </Border.Background>
                    </Border>
                    
                    <StackPanel Width="250" VerticalAlignment="Center">
                        <TextBlock Text="Red" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Slider Minimum="0" Maximum="255" Value="{Binding Red}" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Green" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Slider Minimum="0" Maximum="255" Value="{Binding Green}" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Blue" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Slider Minimum="0" Maximum="255" Value="{Binding Blue}" Margin="0,0,0,10"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
