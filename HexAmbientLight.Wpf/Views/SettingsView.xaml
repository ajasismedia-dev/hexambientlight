<UserControl x:Class="HexAmbientLight.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:HexAmbientLight.Wpf.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{loc:Translate Key=Settings.Title}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ModernTextBrush}" />
            <TextBlock Text="{loc:Translate Key=Settings.Desc}" FontSize="14" Foreground="{StaticResource ModernTextMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{loc:Translate Key=Common.Language}" FontWeight="SemiBold" Foreground="{StaticResource ModernTextBrush}" Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding UiLanguage}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,20">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="en-US">
                                            <Setter Property="Text" Value="English"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="tr-TR">
                                            <Setter Property="Text" Value="Türkçe"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{loc:Translate Key=Settings.WledIp}" FontWeight="SemiBold" Foreground="{StaticResource ModernTextBrush}" Margin="0,0,0,8" />
            <TextBox Text="{Binding WledIpAddress, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,20" Background="#1A1A20" Foreground="#E0E0E0" BorderThickness="1" BorderBrush="#333" Padding="6"/>

            <CheckBox Content="{loc:Translate Key=Settings.StartWithWindows}" IsEnabled="False" Foreground="{StaticResource ModernTextMutedBrush}" Margin="0,0,0,10" />
            <CheckBox Content="{loc:Translate Key=Settings.CloseToTray}" IsEnabled="False" Foreground="{StaticResource ModernTextMutedBrush}" />
        </StackPanel>
    </Grid>
</UserControl>

