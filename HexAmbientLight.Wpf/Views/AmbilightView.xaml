<UserControl x:Class="HexAmbientLight.Wpf.Views.AmbilightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>
    <StackPanel Margin="10">
        <TextBlock Text="Translate Nav.Ambilight" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,5"/>
        <TextBlock Text="Translate Ambilight.Desc" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,20"/>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20" BorderBrush="{DynamicResource AccentOrangeBrush}">
            <StackPanel>
                <TextBlock Text="Translate Common.HDRWarning" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentOrangeBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Translate Common.HDRWarningText" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </Border>

                <Border Style="{DynamicResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Translate Nav.Settings" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>
                
                <TextBlock Text="{Binding TargetFps, StringFormat='Target FPS: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,5"/>
                <Slider Minimum="15" Maximum="60" TickFrequency="15" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" Value="{Binding TargetFps}"/>
                
                <TextBlock Text="{Binding Brightness, StringFormat='Brightness Limit: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                <Slider Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" Value="{Binding Brightness}"/>

                <TextBlock Text="{Binding Saturation, StringFormat='Saturation: {0:F1}'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                <Slider Minimum="0.0" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" Value="{Binding Saturation}"/>

                <TextBlock Text="{Binding SmoothingPercent, StringFormat='Smoothing: {0}%'}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" Value="{Binding SmoothingPercent}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>




