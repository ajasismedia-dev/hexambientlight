<UserControl x:Class="HexAmbientLight.Wpf.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.RenderTransform>
        <TranslateTransform Y="0"/>
    </UserControl.RenderTransform>
    <StackPanel Margin="10">
        <TextBlock Text="Device Configuration" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,5"/>
        <TextBlock Text="WLED connection and monitor layout" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,20"/>

        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="WLED Settings" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>
                <TextBlock Text="IP Address:" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding WledIp, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,15" Padding="5"/>
                
                <Button Content="Save Configuration" Command="{Binding SaveSettingsCommand}" Width="150" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ters U LED Preview -->
                <Grid Grid.Column="0" Width="250" Height="150" Margin="0,0,20,0">
                    <!-- Top -->
                    <Border Height="10" Background="{DynamicResource AccentPurpleBrush}" VerticalAlignment="Top" CornerRadius="5"/>
                    <TextBlock Text="{Binding TopCount, StringFormat={}{0}}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    
                    <!-- Left -->
                    <Border Width="10" Background="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Left" Margin="0,10,0,0" CornerRadius="5"/>
                    <TextBlock Text="{Binding LeftCount, StringFormat={}{0}}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- Right -->
                    <Border Width="10" Background="{DynamicResource AccentLimeBrush}" HorizontalAlignment="Right" Margin="0,10,0,0" CornerRadius="5"/>
                    <TextBlock Text="{Binding RightCount, StringFormat={}{0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="LED Layout (Read-only)" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Total LEDs: " Foreground="{DynamicResource TextSecondaryBrush}" Width="100"/>
                        <TextBlock Text="{Binding TotalCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
