<Window x:Class="HexAmbientLight.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:HexAmbientLight.Wpf.ViewModels"
        xmlns:views="clr-namespace:HexAmbientLight.Wpf.Views"
        Title="HexAmbientLight" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        Background="{DynamicResource BgMainBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
        
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AmbilightViewModel}">
            <views:AmbilightView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:GameViewModel}">
            <views:GameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ManualViewModel}">
            <views:ManualView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DeviceViewModel}">
            <views:DeviceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo/Brand -->
                <StackPanel Grid.Row="0" Margin="20,24,20,32" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 10,0 L 20,5 L 20,15 L 10,20 L 0,15 L 0,5 Z" Fill="{DynamicResource AccentBrush}" Width="20" Height="20" Stretch="Fill"/>
                    <TextBlock Text="HexAmbientLight" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="10,0">
                        <RadioButton Content="Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" IsChecked="{Binding CurrentViewModel, Mode=OneWay, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type viewModels:DashboardViewModel}}" Style="{DynamicResource NavMenuRadioButtonStyle}"/>
                        <RadioButton Content="Ambilight" Command="{Binding NavigateCommand}" CommandParameter="Ambilight" IsChecked="{Binding CurrentViewModel, Mode=OneWay, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type viewModels:AmbilightViewModel}}" Style="{DynamicResource NavMenuRadioButtonStyle}" Margin="0,4,0,0"/>
                        <RadioButton Content="CS2 Game Sync" Command="{Binding NavigateCommand}" CommandParameter="Game" IsChecked="{Binding CurrentViewModel, Mode=OneWay, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type viewModels:GameViewModel}}" Style="{DynamicResource NavMenuRadioButtonStyle}" Margin="0,4,0,0"/>
                        <RadioButton Content="Manual Color" Command="{Binding NavigateCommand}" CommandParameter="Manual" IsChecked="{Binding CurrentViewModel, Mode=OneWay, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type viewModels:ManualViewModel}}" Style="{DynamicResource NavMenuRadioButtonStyle}" Margin="0,4,0,0"/>
                        
                        <Separator Margin="0,16" Background="{DynamicResource BorderBrush}"/>
                        
                        <RadioButton Content="WLED Devices" Command="{Binding NavigateCommand}" CommandParameter="Device" IsChecked="{Binding CurrentViewModel, Mode=OneWay, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type viewModels:DeviceViewModel}}" Style="{DynamicResource NavMenuRadioButtonStyle}"/>
                        <RadioButton Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings" IsChecked="{Binding CurrentViewModel, Mode=OneWay, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type viewModels:SettingsViewModel}}" Style="{DynamicResource NavMenuRadioButtonStyle}" Margin="0,4,0,0"/>
                        <RadioButton Content="Diagnostics" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" IsChecked="{Binding CurrentViewModel, Mode=OneWay, Converter={StaticResource TypeToBoolConverter}, ConverterParameter={x:Type viewModels:DiagnosticsViewModel}}" Style="{DynamicResource NavMenuRadioButtonStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="{DynamicResource BgMainBrush}">
            <ContentControl Content="{Binding CurrentViewModel}" Margin="0"/>
        </Border>
    </Grid>
</Window>
